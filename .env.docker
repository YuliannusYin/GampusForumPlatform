# ============================================================
# 校园论坛平台 Docker 部署环境变量模板
# ------------------------------------------------------------
# 使用前请将本文件复制为 .env 并根据实际环境修改：
#   cp .env.docker .env
# docker compose 会自动加载同目录下的 .env 文件
# 注意：.env 文件包含敏感信息，请勿提交到 git
# ============================================================

# ---------- MySQL 配置 ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=campus_forum
MYSQL_USER=campus
MYSQL_PASSWORD=campus123456

# ---------- JWT 配置 ----------
JWT_SECRET=your-super-secret-key-change-this-in-production-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE=7200
JWT_REFRESH_TOKEN_EXPIRE=604800
